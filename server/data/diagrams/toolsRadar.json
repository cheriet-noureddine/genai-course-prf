{
  "key": "toolsRadar",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🧭 Comparatif des outils IA</h4>\n      <div class=\"chart-wrap\"><canvas id=\"chart-toolsradar\"></canvas></div>\n      <p style=\"font-size:.78rem;color:var(--ink-soft);margin-top:8px;\">Valeurs indicatives à but pédagogique — à vérifier selon les offres actuelles de chaque éditeur.</p>\n    </div>\n    <script>\n    (function(){\n      var ctx = document.getElementById('chart-toolsradar');\n      if(!ctx) return;\n      new Chart(ctx, {\n        type:'radar',\n        data:{\n          labels:['Gratuit','Intégration Google/Microsoft','Documents longs','Multimodalité','Simplicité'],\n          datasets:[\n            {label:'ChatGPT', data:[70,50,60,80,85], borderColor:'#2f7d4f', backgroundColor:'rgba(47,125,79,0.12)'},\n            {label:'Claude', data:[65,40,95,70,80], borderColor:'#0f6e64', backgroundColor:'rgba(15,110,100,0.12)'},\n            {label:'Gemini', data:[80,95,55,85,75], borderColor:'#9c6b1f', backgroundColor:'rgba(156,107,31,0.12)'},\n            {label:'Copilot', data:[55,90,50,60,70], borderColor:'#5b4b8a', backgroundColor:'rgba(91,75,138,0.12)'}\n          ]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:11}}}},scales:{r:{suggestedMin:0,suggestedMax:100,ticks:{display:false},grid:{color:'rgba(0,0,0,0.07)'}}}}\n      });\n    })();\n    </script>"
}