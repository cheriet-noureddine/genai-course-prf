{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>⚙️ System Prompt vs User Prompt Architecture</h4>\n      <div style=\"display:flex;flex-direction:column;gap:0;border:1.5px solid var(--rule);border-radius:10px;overflow:hidden;\">\n        <div style=\"background:#5b4b8a;color:#fff;padding:14px 18px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;margin-bottom:4px;opacity:.8;\">SYSTEM PROMPT (set once, invisible to end users)</div>\n          <div style=\"font-size:.88rem;\">\"You are Riley, a friendly support agent for Northwind Gear. Never promise refunds. Always ask for the order number first. Respond in under 100 words.\"</div>\n        </div>\n        <div style=\"background:#e6f0ff;padding:14px 18px;border-top:2px dashed #9ab;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#5b4b8a;margin-bottom:4px;\">USER MESSAGES (per interaction)</div>\n          <div style=\"font-size:.88rem;color:#333;\">\"Hi, my order hasn't arrived yet.\"</div>\n        </div>\n        <div style=\"background:var(--ok-soft);padding:14px 18px;border-top:2px dashed #9ab;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--ok);margin-bottom:4px;\">AI RESPONSE (constrained by system)</div>\n          <div style=\"font-size:.88rem;color:#1a5e33;\">\"Hi! I'm sorry to hear that. Could you share your order number so I can look into this right away?\"</div>\n        </div>\n      </div>\n    </div>"
}