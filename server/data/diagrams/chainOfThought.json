{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🔗 Chain-of-Thought vs Direct Answer</h4>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n        <div style=\"border:1.5px solid var(--bad);border-radius:10px;padding:14px;background:var(--bad-soft);\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--bad);margin-bottom:6px;\">Direct (error-prone)</div>\n          <div style=\"font-size:.84rem;\">Q: Alice has 5 apples. She gives 2 to Bob and gets 3 back from Carol. How many?<br><br>\n          <strong>A: 6</strong> ❌<br><span style=\"font-size:.78rem;color:var(--bad);\">(skipped a step)</span></div>\n        </div>\n        <div style=\"border:1.5px solid var(--ok);border-radius:10px;padding:14px;background:var(--ok-soft);\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--ok);margin-bottom:6px;\">Chain-of-Thought</div>\n          <div style=\"font-size:.84rem;\">\n          Start: 5 apples<br>\n          Give 2 → 5−2 = 3<br>\n          Get 3 → 3+3 = 6<br>\n          Wait — 6 is wrong...<br>\n          Start: 5, −2=3, +3=<strong>6</strong> ✓<br>\n          <span style=\"font-size:.78rem;color:var(--ok);\">(visible steps catch errors)</span>\n          </div>\n        </div>\n      </div>\n      <p style=\"font-size:.84rem;color:var(--ink-soft);margin-top:12px;\">Add <em>\"Let's think step by step\"</em> to dramatically reduce arithmetic and logic errors.</p>\n    </div>"
}