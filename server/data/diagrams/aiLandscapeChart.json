{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🏢 AI Model Landscape</h4>\n      <div class=\"chart-wrap\" style=\"height:220px;\"><canvas id=\"chart-landscape\"></canvas></div>\n    </div>\n    <script>\n    (function(){\n      var ctx=document.getElementById('chart-landscape');\n      if(!ctx) return;\n      new Chart(ctx,{\n        type:'radar',\n        data:{\n          labels:['Reasoning','Code','Long Docs','Multimodal','Speed','Open-weight'],\n          datasets:[\n            {label:'GPT-4o',data:[90,88,80,95,75,0],borderColor:'#10a37f',backgroundColor:'rgba(16,163,127,0.1)',pointBackgroundColor:'#10a37f'},\n            {label:'Claude',data:[92,90,95,70,70,0],borderColor:'#c8650f',backgroundColor:'rgba(200,101,15,0.1)',pointBackgroundColor:'#c8650f'},\n            {label:'Gemini',data:[85,82,85,98,80,0],borderColor:'#4285f4',backgroundColor:'rgba(66,133,244,0.1)',pointBackgroundColor:'#4285f4'},\n            {label:'LLaMA',data:[75,80,70,60,85,100],borderColor:'#5b4b8a',backgroundColor:'rgba(91,75,138,0.1)',pointBackgroundColor:'#5b4b8a'}\n          ]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:11}}}},scales:{r:{suggestedMin:0,suggestedMax:100,ticks:{display:false},grid:{color:'rgba(0,0,0,0.07)'}}}}\n      });\n    })();\n    </script>"
}