{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🔀 Generative vs Discriminative AI</h4>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px;\">\n        <div style=\"background:#fbe6e3;border:1.5px solid #e8c2bd;border-radius:10px;padding:14px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#b3413a;margin-bottom:8px;\">Discriminative</div>\n          <div style=\"font-size:.88rem;color:#444;\">Takes existing content → <strong>classifies or scores it</strong></div>\n          <div style=\"margin-top:10px;font-size:.8rem;background:#fff;border-radius:6px;padding:8px;\">\n            📧 Email → <strong>Spam / Not Spam</strong><br>\n            🖼️ Image → <strong>Cat / Dog</strong><br>\n            💳 Transaction → <strong>Fraud / Legit</strong>\n          </div>\n        </div>\n        <div style=\"background:#e2f1e6;border:1.5px solid #c2dfc9;border-radius:10px;padding:14px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#2f7d4f;margin-bottom:8px;\">Generative</div>\n          <div style=\"font-size:.88rem;color:#444;\">Takes a prompt → <strong>creates new content</strong></div>\n          <div style=\"margin-top:10px;font-size:.8rem;background:#fff;border-radius:6px;padding:8px;\">\n            💬 Text prompt → <strong>New essay</strong><br>\n            🎨 Description → <strong>New image</strong><br>\n            🎵 Instructions → <strong>New music</strong>\n          </div>\n        </div>\n      </div>\n    </div>"
}