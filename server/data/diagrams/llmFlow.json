{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>⚙️ How an LLM Generates a Response (Token by Token)</h4>\n      <div style=\"font-size:.88rem;color:var(--ink-soft);margin-bottom:14px;\">Watch how the model extends text one token at a time:</div>\n      <div id=\"llmDemoText\" style=\"font-family:'JetBrains Mono',monospace;font-size:.88rem;background:var(--paper2);padding:12px;border-radius:8px;min-height:48px;line-height:2;\"></div>\n      <div style=\"margin-top:10px;display:flex;gap:8px;\">\n        <button onclick=\"startLLMDemo()\" style=\"padding:7px 14px;background:var(--teal);color:#fff;border:none;border-radius:7px;cursor:pointer;font-weight:600;font-size:.85rem;\">▶ Generate</button>\n        <button onclick=\"stopLLMDemo()\" style=\"padding:7px 14px;border:1px solid var(--rule);background:var(--paper2);border-radius:7px;cursor:pointer;font-size:.85rem;\">■ Stop</button>\n      </div>\n      <div style=\"margin-top:14px;background:#f8f4ff;border:1px solid #d4c6f4;border-radius:8px;padding:12px;font-size:.84rem;\">\n        <strong style=\"color:#5b4b8a;\">Key insight:</strong> No database lookup happens here. The model predicts <em>statistically likely</em> next tokens based on everything it learned during training.\n      </div>\n    </div>\n    <script>\n    var llmTimer=null;\n    var llmTokens=['The',' prompt',' engineering',' course',' covers',' how',' to',' write',' clear',' instructions',' so',' AI',' models',' produce',' better',' results.',' Each',' token',' is',' predicted',' one',' at',' a',' time',' based',' on',' patterns',' learned',' during',' training','.',' ✓'];\n    var llmIdx=0;\n    function startLLMDemo(){\n      stopLLMDemo();llmIdx=0;\n      document.getElementById('llmDemoText').innerHTML='<span style=\"color:#9c6b1f;font-size:.75rem;\">INPUT: \"Summarize this course in one sentence.\"</span><br>';\n      llmTimer=setInterval(function(){\n        if(llmIdx>=llmTokens.length){stopLLMDemo();return;}\n        var span=document.createElement('span');\n        span.textContent=llmTokens[llmIdx];\n        span.style.cssText='background:#0f6e6430;border-radius:3px;animation:fadeIn .2s ease;';\n        document.getElementById('llmDemoText').appendChild(span);\n        setTimeout(function(){span.style.background='transparent';},400);\n        llmIdx++;\n      },220);\n    }\n    function stopLLMDemo(){if(llmTimer){clearInterval(llmTimer);llmTimer=null;}}\n    </script>"
}