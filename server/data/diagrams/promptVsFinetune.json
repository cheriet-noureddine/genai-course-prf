{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>⚖️ Prompting vs Fine-Tuning Decision Guide</h4>\n      <div class=\"chart-wrap\" style=\"height:200px;\"><canvas id=\"chart-ptft\"></canvas></div>\n      <div style=\"display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;\">\n        <div style=\"flex:1;min-width:200px;background:#e6f0ff;border-radius:8px;padding:10px 12px;font-size:.82rem;\">\n          <strong style=\"color:#5b4b8a;\">✅ Use Prompting when:</strong><br>\n          fast iteration needed, task changes often, few examples available\n        </div>\n        <div style=\"flex:1;min-width:200px;background:var(--amber-soft);border-radius:8px;padding:10px 12px;font-size:.82rem;\">\n          <strong style=\"color:var(--amber);\">⚙️ Consider Fine-tuning when:</strong><br>\n          large repetitive task, 1000s of examples, prompting maxed out\n        </div>\n      </div>\n    </div>\n    <script>\n    (function(){\n      var ctx=document.getElementById('chart-ptft');\n      if(!ctx) return;\n      new Chart(ctx,{\n        type:'bar',\n        data:{\n          labels:['Setup Speed','Flexibility','Data Needed','Scale Cost','Reliability'],\n          datasets:[\n            {label:'Prompting',data:[95,90,10,70,75],backgroundColor:'rgba(15,110,100,0.7)',borderRadius:5},\n            {label:'Fine-tuning',data:[15,30,95,30,90],backgroundColor:'rgba(200,101,15,0.7)',borderRadius:5}\n          ]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'top'}},scales:{y:{max:100,display:false},x:{grid:{display:false}}}}\n      });\n    })();\n    </script>"
}