{
  "key": "promptAnatomy",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🧩 Anatomie d'un bon prompt</h4>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:10px;\">\n        <div style=\"background:#e2f1e6;border:1.5px solid #c2dfc9;border-radius:10px;padding:12px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#2f7d4f;margin-bottom:6px;\">Public</div>\n          <div style=\"font-size:.85rem;color:#444;\">À qui s'adresse la réponse ? (niveau, âge, contexte)</div>\n        </div>\n        <div style=\"background:#fdf1de;border:1.5px solid #ecd9b6;border-radius:10px;padding:12px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#9c6b1f;margin-bottom:6px;\">Format</div>\n          <div style=\"font-size:.85rem;color:#444;\">Sous quelle forme ? (liste, tableau, QCM, email...)</div>\n        </div>\n        <div style=\"background:#fbe6e3;border:1.5px solid #e8c2bd;border-radius:10px;padding:12px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:#b3413a;margin-bottom:6px;\">Contraintes</div>\n          <div style=\"font-size:.85rem;color:#444;\">Longueur, ton, ce qu'il faut éviter</div>\n        </div>\n      </div>\n      <div style=\"margin-top:14px;background:#fff;border:1px solid var(--rule);border-radius:8px;padding:12px;font-family:'JetBrains Mono',monospace;font-size:.78rem;color:var(--ink-soft);\">\n        \"Crée un <span style=\"color:#9c6b1f;font-weight:600;\">QCM de 6 questions</span> sur la Révolution française pour des <span style=\"color:#2f7d4f;font-weight:600;\">élèves de 4e</span>, <span style=\"color:#b3413a;font-weight:600;\">une seule bonne réponse par question, corrigé séparé</span>.\"\n      </div>\n    </div>"
}