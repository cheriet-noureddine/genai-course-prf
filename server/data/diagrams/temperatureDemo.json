{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🌡️ Temperature: Creativity vs Reliability</h4>\n      <div style=\"display:flex;justify-content:space-between;font-size:.78rem;color:var(--ink-soft);margin-bottom:4px;\">\n        <span>0 — Deterministic</span><span>2 — Maximum creativity</span>\n      </div>\n      <input type=\"range\" min=\"0\" max=\"20\" value=\"7\" class=\"temp-slider\" id=\"tempSlider\" oninput=\"updateTempDemo(this.value)\">\n      <div style=\"display:flex;justify-content:space-between;font-size:.76rem;color:var(--ink-soft);margin-bottom:10px;\">\n        <span>Focused · Reliable · Repetitive</span><span>Creative · Varied · Risky</span>\n      </div>\n      <div class=\"temp-output\" id=\"tempOutput\"></div>\n      <div class=\"chart-wrap\" style=\"height:180px;margin-top:16px;\"><canvas id=\"chart-temp\"></canvas></div>\n    </div>\n    <script>\n    var tempExamples={\n      0:'The capital of France is Paris.',\n      3:'The capital of France is Paris, a city renowned for culture and cuisine.',\n      7:'Paris, France's luminous capital, blends baroque grandeur with modern creativity.',\n      12:'Ah, Paris! Where croissants conspire with the Eiffel Tower in a daily plot to steal your heart.',\n      17:'Paris dances on the tongue like a baguette dipped in starlight and existential wonder.',\n      20:'Frenchness... swirling beret pigeons! The Eiffel spires toward purple octopus dreams!!!'\n    };\n    var tempChart;\n    (function(){\n      var ctx=document.getElementById('chart-temp');\n      if(!ctx) return;\n      tempChart=new Chart(ctx,{\n        type:'bar',\n        data:{\n          labels:['Predictability','Creativity','Risk of Errors','Variety'],\n          datasets:[{label:'Current Settings',data:[90,30,5,20],backgroundColor:['#0f6e64','#9c6b1f','#b3413a','#5b4b8a'],borderRadius:6}]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{max:100,display:false},x:{grid:{display:false}}}}\n      });\n    })();\n    function updateTempDemo(v){\n      var t=parseInt(v)/10;\n      var keys=Object.keys(tempExamples).map(Number).sort(function(a,b){return a-b;});\n      var best=keys[0];\n      keys.forEach(function(k){if(Math.abs(k-v)<=Math.abs(best-v)) best=k;});\n      document.getElementById('tempOutput').textContent='Temperature '+t.toFixed(1)+': \"'+tempExamples[best]+'\"';\n      if(tempChart){\n        tempChart.data.datasets[0].data=[\n          Math.max(10,100-v*4.5),\n          Math.min(95,v*4.5),\n          Math.min(90,v*4),\n          Math.min(90,v*4.2)\n        ];\n        tempChart.update();\n      }\n    }\n    updateTempDemo(7);\n    </script>"
}