{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🎯 Zero-Shot vs Few-Shot Prompting</h4>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n        <div style=\"border:1.5px solid var(--rule);border-radius:10px;padding:14px;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px;\">Zero-Shot</div>\n          <pre style=\"font-size:.78rem;background:var(--paper2);padding:8px;border-radius:6px;white-space:pre-wrap;\">Classify: \"The app crashed on launch\"\n→ Category: ?</pre>\n          <div style=\"margin-top:8px;font-size:.82rem;color:var(--ink-soft);\">Model guesses from general knowledge</div>\n        </div>\n        <div style=\"border:1.5px solid var(--teal);border-radius:10px;padding:14px;background:#f0faf8;\">\n          <div style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;color:var(--teal);margin-bottom:8px;\">Few-Shot</div>\n          <pre style=\"font-size:.78rem;background:var(--paper2);padding:8px;border-radius:6px;white-space:pre-wrap;\">\"Can't login\" → Bug\n\"Add dark mode\" → Feature\n\"Love it!\" → Praise\n\n\"App crashed on launch\" → ?</pre>\n          <div style=\"margin-top:8px;font-size:.82rem;color:var(--teal-deep);\">Model infers pattern from examples → <strong>Bug</strong></div>\n        </div>\n      </div>\n      <div style=\"margin-top:12px;font-size:.85rem;color:var(--ink-soft);background:var(--paper2);padding:10px;border-radius:8px;\">\n        📊 Few-shot typically improves accuracy 15–40% on classification tasks requiring specific formats.\n      </div>\n    </div>"
}