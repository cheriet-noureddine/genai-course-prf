{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>📈 AI Evolution Timeline</h4>\n      <div class=\"chart-wrap\"><canvas id=\"chart-aievo\"></canvas></div>\n    </div>\n    <script>\n    (function(){\n      var ctx = document.getElementById('chart-aievo');\n      if(!ctx) return;\n      new Chart(ctx, {\n        type:'line',\n        data:{\n          labels:['1950s','1970s','1990s','2012','2017','2020','2023'],\n          datasets:[{\n            label:'AI Capability (relative)',\n            data:[5,12,20,40,55,80,100],\n            borderColor:'#0f6e64',backgroundColor:'rgba(15,110,100,0.10)',\n            tension:0.4,fill:true,pointBackgroundColor:'#0f6e64',pointRadius:5\n          }]\n        },\n        options:{\n          responsive:true,maintainAspectRatio:false,\n          plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){\n            var labels=['Rules-based systems','Expert systems','Machine Learning','Deep Learning (ImageNet)','Transformer architecture','GPT-3 era','Modern LLMs'];\n            return labels[c.dataIndex];\n          }}}},\n          scales:{y:{display:false},x:{grid:{color:'rgba(0,0,0,0.05)'}}}\n        }\n      });\n    })();\n    </script>"
}