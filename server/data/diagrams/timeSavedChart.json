{
  "key": "timeSavedChart",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>⏱️ Temps gagné avec des prompts modèles</h4>\n      <div class=\"chart-wrap\"><canvas id=\"chart-timesaved\"></canvas></div>\n      <p style=\"font-size:.78rem;color:var(--ink-soft);margin-top:8px;\">Illustration : un prompt modèle réutilisé évite de repartir de zéro à chaque préparation.</p>\n    </div>\n    <script>\n    (function(){\n      var ctx = document.getElementById('chart-timesaved');\n      if(!ctx) return;\n      new Chart(ctx, {\n        type:'bar',\n        data:{\n          labels:['Fiche de prep','Email parents','Quiz','Corrigé'],\n          datasets:[\n            {label:'Sans modèle (min)', data:[25,15,20,15], backgroundColor:'#e8c2bd'},\n            {label:'Avec prompt modèle (min)', data:[8,5,7,5], backgroundColor:'#0f6e64'}\n          ]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:11}}}},scales:{y:{title:{display:true,text:'minutes'}},x:{grid:{display:false}}}}\n      });\n    })();\n    </script>"
}