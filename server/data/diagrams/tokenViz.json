{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🔤 Interactive Token Visualizer</h4>\n      <p style=\"font-size:.88rem;color:var(--ink-soft);margin-bottom:10px;\">Each colored block = one token (≈ ¾ of a word). Hover to see the token.</p>\n      <div class=\"token-demo\" id=\"tokenDemo\"></div>\n      <div style=\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;\">\n        <button onclick=\"tokenizeText('The quick brown fox jumps over the lazy dog')\" style=\"padding:5px 12px;border:1px solid var(--rule);border-radius:6px;cursor:pointer;font-size:.8rem;background:var(--paper2);\">Simple sentence</button>\n        <button onclick=\"tokenizeText('unbelievable transformational extraordinaire')\" style=\"padding:5px 12px;border:1px solid var(--rule);border-radius:6px;cursor:pointer;font-size:.8rem;background:var(--paper2);\">Long words</button>\n        <button onclick=\"tokenizeText('def fibonacci(n): return n if n<=1 else fibonacci(n-1)+fibonacci(n-2)')\" style=\"padding:5px 12px;border:1px solid var(--rule);border-radius:6px;cursor:pointer;font-size:.8rem;background:var(--paper2);\">Code snippet</button>\n      </div>\n      <div style=\"margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:.78rem;color:var(--ink-soft);\" id=\"tokenCount\"></div>\n    </div>\n    <script>\n    var tokenColors=['#0f6e64','#9c6b1f','#5b4b8a','#b3413a','#2f7d4f','#c8650f','#3a6ab3'];\n    function tokenizeText(text){\n      var words=text.match(/[A-Za-z]+|[^A-Za-zs]+|s+/g)||[];\n      var tokens=[];\n      words.forEach(function(w){\n        if(w.trim()===''){tokens.push(' ');return;}\n        if(w.length>6){var mid=Math.floor(w.length/2);tokens.push(w.slice(0,mid));tokens.push(w.slice(mid));}\n        else tokens.push(w);\n      });\n      var html='';\n      tokens.forEach(function(t,i){\n        if(t===' '){html+='<span style=\"display:inline-block;width:6px;\"></span>';return;}\n        var c=tokenColors[i%tokenColors.length];\n        html+='<span class=\"token\" title=\"Token #'+i+' : '+t+'\" style=\"background:'+c+'20;color:'+c+';border:1px solid '+c+'40;\">'+t+'</span>';\n      });\n      document.getElementById('tokenDemo').innerHTML=html;\n      var real=tokens.filter(function(t){return t!==' ';}).length;\n      document.getElementById('tokenCount').textContent='~'+real+' tokens | ~'+Math.round(real*0.75)+' words equivalent | ~$'+((real*0.000002).toFixed(5))+' (GPT-4o pricing)';\n    }\n    tokenizeText('Hello, my name is Claude.');\n    </script>"
}