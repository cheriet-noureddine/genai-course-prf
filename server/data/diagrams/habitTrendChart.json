{
  "key": "habitTrendChart",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>📈 Construire une habitude durable</h4>\n      <div class=\"chart-wrap\"><canvas id=\"chart-habit\"></canvas></div>\n      <p style=\"font-size:.78rem;color:var(--ink-soft);margin-top:8px;\">Illustration : l'aisance avec l'IA progresse avec la pratique régulière sur de vraies tâches, pas avec la théorie seule.</p>\n    </div>\n    <script>\n    (function(){\n      var ctx = document.getElementById('chart-habit');\n      if(!ctx) return;\n      new Chart(ctx, {\n        type:'line',\n        data:{\n          labels:['Semaine 1','Semaine 2','Semaine 4','Semaine 8','Semaine 12'],\n          datasets:[{label:'Aisance ressentie (indicative)', data:[20,35,55,75,90], borderColor:'#0f6e64', backgroundColor:'rgba(15,110,100,0.10)', tension:0.4, fill:true, pointBackgroundColor:'#0f6e64', pointRadius:5}]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{max:100,display:false},x:{grid:{color:'rgba(0,0,0,0.05)'}}}}\n      });\n    })();\n    </script>"
}