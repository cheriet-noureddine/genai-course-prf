{
  "key": "promptQualityBar",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>📊 Clarté du prompt : avant / après reformulation</h4>\n      <div class=\"chart-wrap\"><canvas id=\"chart-promptquality\"></canvas></div>\n      <p style=\"font-size:.78rem;color:var(--ink-soft);margin-top:8px;\">Illustration pédagogique : plus un prompt précise public, format et contraintes, plus la réponse obtenue est exploitable directement.</p>\n    </div>\n    <script>\n    (function(){\n      var ctx = document.getElementById('chart-promptquality');\n      if(!ctx) return;\n      new Chart(ctx, {\n        type:'bar',\n        data:{\n          labels:['Prompt vague','+ public précisé','+ format précisé','+ contraintes précisées'],\n          datasets:[{label:'Exploitable directement (estimation)', data:[20,45,70,90], backgroundColor:['#e8c2bd','#ecd9b6','#c2dfc9','#0f6e64']}]\n        },\n        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{max:100,display:false},x:{grid:{display:false}}}}\n      });\n    })();\n    </script>"
}