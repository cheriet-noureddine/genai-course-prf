{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>📊 Prompt Evaluation Framework</h4>\n      <p style=\"font-size:.82rem;color:var(--ink-soft);margin-bottom:12px;\">Click any bar to learn what it measures.</p>\n      <div id=\"evalBarsWrap\"></div>\n      <div id=\"evalInfoBox\" style=\"margin-top:14px;min-height:52px;padding:12px 16px;border-radius:8px;font-size:.86rem;background:var(--paper2);border:1px solid var(--rule);color:var(--ink-soft);\">\n        👆 Click a metric bar above to see its definition.\n      </div>\n    </div>\n    <script>\n    function buildEvalBars(){\n      var wrap = document.getElementById('evalBarsWrap');\n      var info = document.getElementById('evalInfoBox');\n      if(!wrap || !info){ setTimeout(buildEvalBars, 60); return; }\n      if(wrap.childElementCount > 0) return; // already built\n      var metrics=[\n        {name:'Accuracy',val:85,desc:'Does the output match the correct answer? Key for classification tasks with a clear right answer.',color:'#0f6e64',icon:'🎯'},\n        {name:'Consistency',val:72,desc:'Does the prompt produce good results across many different inputs, not just one test case?',color:'#9c6b1f',icon:'🔁'},\n        {name:'Relevance',val:90,desc:'Does the response address what was asked? High relevance means no off-topic tangents.',color:'#5b4b8a',icon:'✅'},\n        {name:'Cost / Latency',val:60,desc:'How many tokens does it consume and how long does it take? Matters most at scale.',color:'#b3413a',icon:'⏱'},\n        {name:'Safety',val:95,desc:'Does the output avoid harmful, biased, or policy-violating content? Essential for user-facing apps.',color:'#2f7d4f',icon:'🛡'}\n      ];\n      metrics.forEach(function(m, idx){\n        var row = document.createElement('div');\n        row.style.cssText = 'display:flex;align-items:center;gap:10px;cursor:pointer;border-radius:8px;padding:5px 6px;margin:4px 0;transition:background .15s;';\n        var label = document.createElement('div');\n        label.style.cssText = 'font-size:.83rem;font-weight:600;min-width:120px;color:var(--ink-soft);';\n        label.textContent = m.name;\n        var barWrap = document.createElement('div');\n        barWrap.style.cssText = 'flex:1;background:var(--paper2);border-radius:4px;overflow:hidden;height:22px;pointer-events:none;';\n        var bar = document.createElement('div');\n        bar.style.cssText = 'height:100%;border-radius:4px;background:'+m.color+';display:flex;align-items:center;padding-left:8px;color:#fff;font-size:.75rem;font-weight:600;width:'+m.val+'%;pointer-events:none;';\n        bar.textContent = m.val+'%';\n        barWrap.appendChild(bar);\n        row.appendChild(label);\n        row.appendChild(barWrap);\n        row.addEventListener('click', function(){\n          // Reset all rows\n          wrap.querySelectorAll('div[data-metric]').forEach(function(r){\n            r.style.background='';\n            r.querySelector('div').style.color='var(--ink-soft)';\n          });\n          row.style.background = m.color+'18';\n          label.style.color = m.color;\n          info.style.background = m.color+'12';\n          info.style.borderColor = m.color+'60';\n          info.style.color = 'var(--ink)';\n          info.innerHTML = '<strong style=\"color:'+m.color+'\">'+m.icon+' '+m.name+'</strong> — '+m.desc;\n        });\n        row.addEventListener('mouseenter', function(){ if(!info.innerHTML.includes(m.name)) row.style.background=m.color+'0d'; });\n        row.addEventListener('mouseleave', function(){ if(!info.innerHTML.includes(m.name)) row.style.background=''; });\n        row.setAttribute('data-metric', idx);\n        wrap.appendChild(row);\n      });\n    }\n    buildEvalBars();\n    </script>"
}