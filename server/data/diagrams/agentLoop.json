{
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🤖 AI Agent Loop</h4>\n      <div style=\"display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;padding:10px 0;\">\n        <div style=\"background:#5b4b8a;color:#fff;padding:14px 18px;border-radius:10px;text-align:center;min-width:100px;\">\n          <div style=\"font-size:1.4rem;\">🎯</div>\n          <div style=\"font-weight:700;font-size:.9rem;margin-top:4px;\">Goal</div>\n          <div style=\"font-size:.75rem;opacity:.8;\">\"Research topic X and write a summary\"</div>\n        </div>\n        <div style=\"font-size:1.3rem;color:var(--ink-soft);padding:0 8px;\">→</div>\n        <div style=\"display:flex;flex-direction:column;gap:8px;border:2px dashed var(--rule);border-radius:12px;padding:14px;background:var(--paper2);\">\n          <div style=\"display:flex;align-items:center;gap:8px;\">\n            <div style=\"background:var(--teal);color:#fff;padding:7px 12px;border-radius:7px;font-size:.82rem;font-weight:700;\">📋 Plan</div>\n            <div style=\"font-size:.78rem;color:var(--ink-soft);\">Break into steps</div>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:8px;\">\n            <div style=\"background:var(--amber);color:#fff;padding:7px 12px;border-radius:7px;font-size:.82rem;font-weight:700;\">⚡ Act</div>\n            <div style=\"font-size:.78rem;color:var(--ink-soft);\">Use tool (search, code, API)</div>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:8px;\">\n            <div style=\"background:#5b4b8a;color:#fff;padding:7px 12px;border-radius:7px;font-size:.82rem;font-weight:700;\">👁 Observe</div>\n            <div style=\"font-size:.78rem;color:var(--ink-soft);\">Read result, update plan</div>\n          </div>\n          <div style=\"font-size:.78rem;text-align:center;color:var(--ink-soft);\">↑ repeat until done ↑</div>\n        </div>\n        <div style=\"font-size:1.3rem;color:var(--ink-soft);padding:0 8px;\">→</div>\n        <div style=\"background:var(--ok);color:#fff;padding:14px 18px;border-radius:10px;text-align:center;min-width:100px;\">\n          <div style=\"font-size:1.4rem;\">✅</div>\n          <div style=\"font-weight:700;font-size:.9rem;margin-top:4px;\">Result</div>\n          <div style=\"font-size:.75rem;opacity:.9;\">Final output delivered</div>\n        </div>\n      </div>\n    </div>"
}