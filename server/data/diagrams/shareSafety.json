{
  "key": "shareSafety",
  "html": "\n    <div class=\"diagram-box\">\n      <h4>🔒 Avant de coller un contenu dans une IA</h4>\n      <div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px;font-size:.85rem;\">\n        <div style=\"background:#fff;border:1px solid var(--rule);border-radius:8px;padding:10px 14px;\">📄 Contenu à coller</div>\n        <div style=\"color:var(--ink-soft);\">→</div>\n        <div style=\"background:#fdf1de;border:1.5px solid #ecd9b6;border-radius:8px;padding:10px 14px;\">❓ Identifie-t-il un élève ?</div>\n        <div style=\"color:var(--ink-soft);\">→</div>\n        <div style=\"display:flex;flex-direction:column;gap:8px;\">\n          <div style=\"background:#fbe6e3;border:1.5px solid #e8c2bd;border-radius:8px;padding:8px 12px;\">🚫 Oui → anonymiser d'abord</div>\n          <div style=\"background:#e2f1e6;border:1.5px solid #c2dfc9;border-radius:8px;padding:8px 12px;\">✅ Non → on peut coller</div>\n        </div>\n      </div>\n    </div>"
}